# Docker test defaults. Copy to .env for local Docker runs if you need to override values.
# Do not put real production secrets in this file.

SPRING_PROFILES_ACTIVE=prod
MYSQL_DATABASE=homepage
DB_URL=jdbc:mysql://mysql:3306/homepage?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=root
JPA_DDL_AUTO=update
JWT_SECRET=replace-this-with-at-least-sixty-four-bytes-for-local-docker-testing
CORS_ALLOWED_ORIGINS=http://localhost:3000
TZ=Asia/Seoul
